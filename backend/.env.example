# ============================================================================
# Backend - Variables de entorno
# Copia este archivo a .env y completa los valores
# ============================================================================

# Conexión a PostgreSQL (obligatoria)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/dbname"
# Secreto para firmar los tokens JWT (obligatorio en producción)
JWT_SECRET="change-me"

# Tiempo de expiración del access token (default: 15m)
JWT_EXPIRES_IN="15m"

# Tiempo de expiración del refresh token (default: 30d)
JWT_REFRESH_EXPIRES_IN="30d"

# Puertos del servidor (default: 3000)
PORT=3000

# URL base del frontend. Se usa para armar el enlace de invitación
# de una reunión: <FRONTEND_URL>/join/<code> (default: http://localhost:5173)
FRONTEND_URL="http://localhost:5173"