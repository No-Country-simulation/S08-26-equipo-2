# Server
PORT=3000

# Database (Supabase PostgreSQL)
# DATABASE_URL usa el pooler (port 6543, ?pgbouncer=true); DIRECT_URL es la conexión directa (port 5432)
DATABASE_URL="postgresql://<user>:<password>@<host-pooler>:6543/<database>?pgbouncer=true"
DIRECT_URL="postgresql://<user>:<password>@<host>:5432/<database>"

# JWT
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"