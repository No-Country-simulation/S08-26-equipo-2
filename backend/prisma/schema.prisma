generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  HOST
  PARTICIPANT
}

enum RoomStatus {
  WAITING
  ACTIVE
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(PARTICIPANT)
  createdAt    DateTime @default(now())
  rooms        Room[]
}

model Room {
  id           String     @id @default(cuid())
  hostId       String
  link         String     @unique
  status       RoomStatus @default(WAITING)
  createdAt    DateTime   @default(now())
  participants User[]
  meetings     Meeting[]
}

model Meeting {
  id              String   @id @default(cuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id])
  scheduledAt     DateTime
  startedAt       DateTime?
  endedAt         DateTime?
  durationMinutes Int?
}